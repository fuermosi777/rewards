<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rewards.daily-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>/Users/god/workspace/rewards/scripts/daily-update.sh</string>
    </array>

    <!-- Runs once a day at 02:00 local time. launchd catches up on missed
         runs if the machine was asleep, but this Mac mini doesn't sleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- daily-update.sh does its own logging to
         ~/Library/Logs/rewards-daily-update/YYYY-MM-DD.log; these just catch
         anything launchd itself has to say (e.g. if the script fails to
         even start). -->
    <key>StandardOutPath</key>
    <string>/Users/god/Library/Logs/rewards-daily-update/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/god/Library/Logs/rewards-daily-update/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
